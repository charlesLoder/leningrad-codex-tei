  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Leningrad Codex — {{ folio }} ({{ verse_range }})</title>
        <respStmt xml:id="leningrad-epidoc">
          <resp>created by</resp>
          <name>leningrad-epidoc</name>
        </respStmt>
      </titleStmt>
      <publicationStmt>
        <authority>leningrad-epidoc</authority>
        <availability status="free">
          <licence>MIT License</licence>
          <p>Generated by leningrad-epidoc pipeline. <ptr target="{{ repo_url }}"/></p>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <msDesc>
          <msIdentifier>
            <settlement>Saint Petersburg</settlement>
            <repository>National Library of Russia</repository>
            <idno>Firkovich B 19 A</idno>
          </msIdentifier>
        </msDesc>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <appInfo>
        <application ident="leningrad-epidoc" version="{{ pipeline_version }}"{% if generated_when %} when="{{ generated_when }}"{% endif %}>
          <label>Leningrad Codex EpiDoc Edition</label>
          <ptr target="{{ repo_snapshot_url or repo_hash }}" type="repo-hash"/>
        </application>
      </appInfo>
    </encodingDesc>
    <revisionDesc>
      {% for change in changes %}
      <change when="{{ change.when }}" who="#leningrad-epidoc">{{ change.text }}
        {% if change.features %}
        <fs type="ai-params">
          {% for feature in change.features %}
          <f name="{{ feature.name }}"><string>{{ feature.value }}</string></f>
          {% endfor %}
        </fs>
        {% endif %}
      </change>
      {% endfor %}
    </revisionDesc>
  </teiHeader>
