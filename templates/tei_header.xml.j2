  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Leningrad Codex — {{ folio }} ({{ verse_range }})</title>
        <respStmt xml:id="leningrad-codex-tei">
          <resp>created by</resp>
          <name>leningrad-codex-tei</name>
        </respStmt>
        <respStmt xml:id="source-uxlc">
          <resp>Base biblical text from the Unicode/XML Leningrad Codex (UXLC){% if uxlc_edition and uxlc_edition.version %} (version {{ uxlc_edition.version }}{% if uxlc_edition.build %}, build {{ uxlc_edition.build }}{% endif %}{% if uxlc_edition.date %}, {{ uxlc_edition.date }}{% endif %}){% endif %} <ptr target="https://www.tanach.us//Books/TEIHeaders/TanachHeader.TEI.html"/></resp>
          <persName>Christopher V. Kimball</persName>
        </respStmt>
        <respStmt xml:id="source-seed">
          <resp>Folio mapping derived from the index of the Leningrad Codex <ptr target="https://github.com/bdenckla/MAM-basics"/></resp>
          <persName>Ben Denckla</persName>
        </respStmt>
        {% for c in contributors %}
        <respStmt xml:id="{{ c.xml_id }}">
          <resp>TEI encoding and alignment</resp>
          {% if c.email %}
          <persName ref="mailto:{{ c.email }}">{{ c.name }}</persName>
          {% else %}
          <persName>{{ c.name }}</persName>
          {% endif %}
        </respStmt>
        {% endfor %}
      </titleStmt>
      <publicationStmt>
        <authority>leningrad-codex-tei</authority>
        <availability status="free">
          <licence>MIT License</licence>
          <p>Generated by leningrad-codex-tei pipeline. <ptr target="{{ repo_url }}"/></p>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <msDesc>
          <msIdentifier>
            <settlement>Saint Petersburg</settlement>
            <repository>National Library of Russia</repository>
            <idno>Firkovich B 19 A</idno>
          </msIdentifier>
        </msDesc>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <appInfo>
        <application ident="leningrad-codex-tei" version="{{ pipeline_version }}"{% if generated_when %} when="{{ generated_when }}"{% endif %}>
          <label>Leningrad Codex TEI</label>
          <ptr target="{{ repo_snapshot_url or repo_hash }}" type="repo-hash"/>
        </application>
      </appInfo>
    </encodingDesc>
    <revisionDesc>
      {% for change in changes %}
      <change when="{{ change.when }}" who="{{ change.who | default('#leningrad-codex-tei', true) }}">{{ change.text }}
        {% if change.prompt_url %}
        <ptr type="prompt" target="{{ change.prompt_url }}"/>
        {% endif %}
        {% if change.features %}
        <fs type="ai-params">
          {% for feature in change.features %}
          <f name="{{ feature.name }}"><string>{{ feature.value }}</string></f>
          {% endfor %}
        </fs>
        {% endif %}
      </change>
      {% endfor %}
    </revisionDesc>
  </teiHeader>
