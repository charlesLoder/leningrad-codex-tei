            <milestone unit="verse" n="Proverbs-31-23" xml:id="f421A-v-Proverbs-31-23" facs="#f421A-zone-Proverbs-31-23"/>
            <w xml:id="f421A-w-247931">בַּעְלָ֑הּ</w>
            <w xml:id="f421A-w-247932">בְּ֝שִׁבְתּ֗וֹ</w>
            <w xml:id="f421A-w-247933">עִם־</w>
            <w xml:id="f421A-w-247934">זִקְנֵי־</w>
            <w xml:id="f421A-w-247935">אָֽרֶץ</w>
            <pc type="sof-pasuq" xml:id="f421A-pc-247935">׃</pc>
            <milestone unit="verse" n="Proverbs-31-24" xml:id="f421A-v-Proverbs-31-24" facs="#f421A-zone-Proverbs-31-24"/>
            <w xml:id="f421A-w-247936">סָדִ֣ין</w>
          <lb xml:id="f421A-lb-1-2" n="2"/>
            <w xml:id="f421A-w-247937">עָ֭שְׂתָה</w>
            <w xml:id="f421A-w-247938">וַתִּמְכֹּ֑ר</w>
            <w xml:id="f421A-w-247939">וַ֝חֲג֗וֹר</w>
            <w xml:id="f421A-w-247940">נָתְנָ֥ה</w>
            <w xml:id="f421A-w-247941">לַֽכְּנַעֲנִֽי</w>
            <pc type="sof-pasuq" xml:id="f421A-pc-247941">׃</pc>
          <lb xml:id="f421A-lb-1-3" n="3"/>
            <milestone unit="verse" n="Proverbs-31-25" xml:id="f421A-v-Proverbs-31-25" facs="#f421A-zone-Proverbs-31-25"/>
            <w xml:id="f421A-w-247942">עֹז־</w>
            <w xml:id="f421A-w-247943">וְהָדָ֥ר</w>
            <w xml:id="f421A-w-247944">לְבוּשָׁ֑הּ</w>
            <w xml:id="f421A-w-247945">וַ֝תִּשְׂחַ֗ק</w>
            <w xml:id="f421A-w-247946">לְי֣וֹם</w>
          <lb xml:id="f421A-lb-1-4" n="4"/>
            <w xml:id="f421A-w-247947">אַחֲרֽוֹן</w>
            <pc type="sof-pasuq" xml:id="f421A-pc-247947">׃</pc>
            <milestone unit="verse" n="Proverbs-31-26" xml:id="f421A-v-Proverbs-31-26" facs="#f421A-zone-Proverbs-31-26"/>
            <w xml:id="f421A-w-247948">פִּ֭יהָ</w>
            <w xml:id="f421A-w-247949">פָּתְחָ֣ה</w>
            <w xml:id="f421A-w-247950">בְחָכְמָ֑ה</w>
            <w xml:id="f421A-w-247951">וְתֽוֹרַת</w>
            <w xml:id="f421A-w-247952">חֶ֝֗סֶד</w>
          <lb xml:id="f421A-lb-1-5" n="5"/>
            <w xml:id="f421A-w-247953">עַל־</w>
            <w xml:id="f421A-w-247954">לְשׁוֹנָֽהּ</w>
            <pc type="sof-pasuq" xml:id="f421A-pc-247954">׃</pc>
            <milestone unit="verse" n="Proverbs-31-27" xml:id="f421A-v-Proverbs-31-27" facs="#f421A-zone-Proverbs-31-27"/>
            <w xml:id="f421A-w-247955">צ֭וֹפִיָּה</w>
            <w xml:id="f421A-w-247956">הֲלִיכ֣וֹת</w>
            <w xml:id="f421A-w-247957">בֵּיתָ֑הּ</w>
          <lb xml:id="f421A-lb-1-6" n="6"/>
            <w xml:id="f421A-w-247958">וְלֶ֥חֶם</w>
            <w xml:id="f421A-w-247959">עַ֝צְל֗וּת</w>
            <w xml:id="f421A-w-247960">לֹ֣א</w>
            <w xml:id="f421A-w-247961">תֹאכֵֽל</w>
            <pc type="sof-pasuq" xml:id="f421A-pc-247961">׃</pc>
