            <w xml:id="f088A-w-58713">וַיֵּרְד֤וּ</w>
            <w xml:id="f088A-w-58714">אֲבֹתֵ֙ינוּ֙</w>
            <w xml:id="f088A-w-58715">מִצְרַ֔יְמָה</w>
          <lb xml:id="f088A-lb-1-3" n="3"/>
            <w xml:id="f088A-w-58716">וַנֵּ֥שֶׁב</w>
            <w xml:id="f088A-w-58717">בְּמִצְרַ֖יִם</w>
            <w xml:id="f088A-w-58718">יָמִ֣ים</w>
            <w xml:id="f088A-w-58719">רַבִּ֑ים</w>
