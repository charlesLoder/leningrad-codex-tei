            <w xml:id="f088A-w-58710">הַתְּלָאָ֖ה</w>
            <w xml:id="f088A-w-58711">אֲשֶׁ֥ר</w>
            <w xml:id="f088A-w-58712">מְצָאָֽתְנוּ</w>
