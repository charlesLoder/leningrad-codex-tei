            <w xml:id="f088A-w-58725">אֶל־</w>
            <w xml:id="f088A-w-58726">יְהוָה֙</w>
            <w xml:id="f088A-w-58727">וַיִּשְׁמַ֣ע</w>
          <lb xml:id="f088A-lb-1-6" n="6"/>
            <w xml:id="f088A-w-58728">קֹלֵ֔נוּ</w>
