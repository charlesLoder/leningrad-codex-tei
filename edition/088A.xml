            <w xml:id="f088A-w-58720">וַיָּרֵ֥עוּ</w>
            <w xml:id="f088A-w-58721">לָ֛נוּ</w>
            <w xml:id="f088A-w-58722">מִצְרַ֖יִם</w>
            <w xml:id="f088A-w-58723">וְלַאֲבֹתֵֽינוּ</w>
            <pc type="sof-pasuq" xml:id="f088A-pc-58723">׃</pc>
          <lb xml:id="f088A-lb-1-5" n="5"/>
