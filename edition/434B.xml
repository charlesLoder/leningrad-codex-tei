            <w xml:id="f434B-w-264510">בְּשׁוּשַׁ֣ן</w>
            <w xml:id="f434B-w-264511">הַבִּירָ֑ה</w>
            <w xml:id="f434B-w-264512">וְהַמֶּ֤לֶךְ</w>
          <lb xml:id="f434B-lb-1-2" n="2"/>
            <w xml:id="f434B-w-264513">וְהָמָן֙</w>
            <w xml:id="f434B-w-264514">יָשְׁב֣וּ</w>
            <w xml:id="f434B-w-264515">לִשְׁתּ֔וֹת</w>
            <w xml:id="f434B-w-264516">וְהָעִ֥יר</w>
          <lb xml:id="f434B-lb-1-3" n="3"/>
            <w xml:id="f434B-w-264517">שׁוּשָׁ֖ן</w>
            <w xml:id="f434B-w-264518">נָבֽוֹכָה</w>
            <pc type="sof-pasuq" xml:id="f434B-pc-264518">׃</pc>
            <milestone unit="section" subtype="pe" xml:id="f434B-s-Esther-3-15"/>
          <lb xml:id="f434B-lb-1-4" n="4"/>
            <milestone unit="verse" n="Esther-4-1" xml:id="f434B-v-Esther-4-1" facs="#f434B-zone-Esther-4-1"/>
            <w xml:id="f434B-w-264519">וּמָרְדֳּכַ֗י</w>
            <w xml:id="f434B-w-264520">יָדַע֙</w>
            <w xml:id="f434B-w-264521">אֶת־</w>
            <w xml:id="f434B-w-264522">כָּל־</w>
          <lb xml:id="f434B-lb-1-5" n="5"/>
            <w xml:id="f434B-w-264523">אֲשֶׁ֣ר</w>
            <w xml:id="f434B-w-264524">נַעֲשָׂ֔ה</w>
            <w xml:id="f434B-w-264525">וַיִּקְרַ֤ע</w>
          <lb xml:id="f434B-lb-1-6" n="6"/>
            <w xml:id="f434B-w-264526">מָרְדֳּכַי֙</w>
            <w xml:id="f434B-w-264527">אֶת־</w>
            <w xml:id="f434B-w-264528">בְּגָדָ֔יו</w>
          <lb xml:id="f434B-lb-1-7" n="7"/>
            <w xml:id="f434B-w-264529">וַיִּלְבַּ֥שׁ</w>
            <w xml:id="f434B-w-264530">שַׂ֖ק</w>
            <w xml:id="f434B-w-264531">וָאֵ֑פֶר</w>
            <w xml:id="f434B-w-264532">וַיֵּצֵא֙</w>
          <lb xml:id="f434B-lb-1-8" n="8"/>
            <w xml:id="f434B-w-264533">בְּת֣וֹךְ</w>
            <w xml:id="f434B-w-264534">הָעִ֔יר</w>
