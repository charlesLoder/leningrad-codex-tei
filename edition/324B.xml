          <lb xml:id="f324B-lb-1-2" n="2"/>
            <w xml:id="f324B-w-220454">וּלְשׁוֹנ֖וֹ</w>
            <w xml:id="f324B-w-220455">תִּמַּ֥ק</w>
            <w xml:id="f324B-w-220456">בְּפִיהֶֽם</w>
