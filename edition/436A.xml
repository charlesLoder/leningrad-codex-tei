            <w xml:id="f436A-w-265391">אֵ֥ין</w>
          <lb xml:id="f436A-lb-1-2" n="2"/>
            <w xml:id="f436A-w-265392">הַצָּ֛ר</w>
            <w xml:id="f436A-w-265393">שֹׁוֶ֖ה</w>
            <w xml:id="f436A-w-265394">בְּנֵ֥זֶק</w>
            <w xml:id="f436A-w-265395">הַמֶּֽלֶךְ</w>
