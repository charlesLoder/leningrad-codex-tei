          <lb xml:id="f436A-lb-1-3" n="3"/>
            <milestone unit="verse" n="Esther-7-5" xml:id="f436A-v-Esther-7-5" facs="#f436A-zone-Esther-7-5"/>
            <w xml:id="f436A-w-265396">וַיֹּ֙אמֶר֙</w>
            <w xml:id="f436A-w-265397">הַמֶּ֣לֶךְ</w>
          <lb xml:id="f436A-lb-1-4" n="4"/>
            <w xml:id="f436A-w-265398">אֲחַשְׁוֵר֔וֹשׁ</w>
            <w xml:id="f436A-w-265399">וַיֹּ֖אמֶר</w>
          <lb xml:id="f436A-lb-1-5" n="5"/>
            <w xml:id="f436A-w-265400">לְאֶסְתֵּ֣ר</w>
            <w xml:id="f436A-w-265401">הַמַּלְכָּ֑ה</w>
            <w xml:id="f436A-w-265402">מִ֣י</w>
            <w xml:id="f436A-w-265403">ה֥וּא</w>
          <lb xml:id="f436A-lb-1-6" n="6"/>
            <w xml:id="f436A-w-265404">זֶה֙</w>
            <w xml:id="f436A-w-265405">וְאֵֽי־</w>
            <w xml:id="f436A-w-265406">זֶ֣ה</w>
            <w xml:id="f436A-w-265407">ה֔וּא</w>
            <w xml:id="f436A-w-265408">אֲשֶׁר־</w>
          <lb xml:id="f436A-lb-1-7" n="7"/>
            <w xml:id="f436A-w-265409">מְלָא֥וֹ</w>
            <w xml:id="f436A-w-265410">לִבּ֖וֹ</w>
            <w xml:id="f436A-w-265411">לַעֲשׂ֥וֹת</w>
            <w xml:id="f436A-w-265412">כֵּֽן</w>
