            <milestone unit="verse" n="Judges-1-1" xml:id="f136A-v-Judges-1-1" facs="#f136A-zone-Judges-1-1"/>
            <w xml:id="f136A-w-90034">וַיְהִ֗י</w>
            <w xml:id="f136A-w-90035">אַחֲרֵי֙</w>
            <w xml:id="f136A-w-90036">מ֣וֹת</w>
            <w xml:id="f136A-w-90037">יְהוֹשֻׁ֔עַ</w>
          <lb xml:id="f136A-lb-1-4" n="4"/>
            <w xml:id="f136A-w-90038">וַֽיִּשְׁאֲלוּ֙</w>
            <w xml:id="f136A-w-90039">בְּנֵ֣י</w>
            <w xml:id="f136A-w-90040">יִשְׂרָאֵ֔ל</w>
            <w xml:id="f136A-w-90041">בַּיהוָ֖ה</w>
          <lb xml:id="f136A-lb-1-5" n="5"/>
            <w xml:id="f136A-w-90042">לֵאמֹ֑ר</w>
            <w xml:id="f136A-w-90043">מִ֣י</w>
            <w xml:id="f136A-w-90044">יַעֲלֶה־</w>
            <w xml:id="f136A-w-90045">לָּ֧נוּ</w>
            <w xml:id="f136A-w-90046">אֶל־</w>
