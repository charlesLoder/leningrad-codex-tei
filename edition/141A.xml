            <w xml:id="f141A-w-93229">וּלְגִדְעֽוֹן</w>
            <pc type="sof-pasuq" xml:id="f141A-pc-93229">׃</pc>
            <milestone unit="section" subtype="pe" xml:id="f141A-s-Judges-7-18"/>
          <lb xml:id="f141A-lb-1-2" n="2"/>
            <milestone unit="verse" n="Judges-7-19" xml:id="f141A-v-Judges-7-19" facs="#f141A-zone-Judges-7-19"/>
            <w xml:id="f141A-w-93230">וַיָּבֹ֣א</w>
            <w xml:id="f141A-w-93231">גִ֠דְעוֹן</w>
            <w xml:id="f141A-w-93232">וּמֵאָה־</w>
            <w xml:id="f141A-w-93233">אִ֨ישׁ</w>
          <lb xml:id="f141A-lb-1-3" n="3"/>
            <w xml:id="f141A-w-93234">אֲשֶׁר־</w>
            <w xml:id="f141A-w-93235">אִתּ֜וֹ</w>
            <w xml:id="f141A-w-93236">בִּקְצֵ֣ה</w>
            <w xml:id="f141A-w-93237">הַֽמַּחֲנֶ֗ה</w>
          <lb xml:id="f141A-lb-1-4" n="4"/>
            <w xml:id="f141A-w-93238">רֹ֚אשׁ</w>
            <w xml:id="f141A-w-93239">הָאַשְׁמֹ֣רֶת</w>
            <w xml:id="f141A-w-93240">הַתִּֽיכוֹנָ֔ה</w>
          <lb xml:id="f141A-lb-1-5" n="5"/>
            <w xml:id="f141A-w-93241">אַ֛ךְ</w>
            <w xml:id="f141A-w-93242">הָקֵ֥ם</w>
            <w xml:id="f141A-w-93243">הֵקִ֖ימוּ</w>
            <w xml:id="f141A-w-93244">אֶת־</w>
            <w xml:id="f141A-w-93245">הַשֹּֽׁמְרִ֑ים</w>
          <lb xml:id="f141A-lb-1-6" n="6"/>
