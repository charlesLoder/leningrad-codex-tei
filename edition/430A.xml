            <w xml:id="f430A-w-258878">אֵיכָ֣ה</w>
            <pc type="paseq" xml:id="f430A-pc-258878">׀</pc>
            <w xml:id="f430A-w-258879">יָשְׁבָ֣ה</w>
            <w xml:id="f430A-w-258880">בָדָ֗ד</w>
            <w xml:id="f430A-w-258881">הָעִיר֙</w>
          <lb xml:id="f430A-lb-1-3" n="3"/>
            <w xml:id="f430A-w-258882">רַבָּ֣תִי</w>
            <w xml:id="f430A-w-258883">עָ֔ם</w>
            <w xml:id="f430A-w-258884">הָיְתָ֖ה</w>
            <w xml:id="f430A-w-258885">כְּאַלְמָנָ֑ה</w>
          <lb xml:id="f430A-lb-1-4" n="4"/>
            <w xml:id="f430A-w-258886">רַּבָּ֣תִי</w>
            <w xml:id="f430A-w-258887">בַגּוֹיִ֗ם</w>
            <w xml:id="f430A-w-258888">שָׂרָ֙תִי֙</w>
            <w xml:id="f430A-w-258889">בַּמְּדִינ֔וֹת</w>
          <lb xml:id="f430A-lb-1-5" n="5"/>
            <w xml:id="f430A-w-258890">הָיְתָ֖ה</w>
            <w xml:id="f430A-w-258891">לָמַֽס</w>
            <pc type="sof-pasuq" xml:id="f430A-pc-258891">׃</pc>
            <milestone unit="section" subtype="samekh" xml:id="f430A-s-Lamentations-1-1"/>
            <milestone unit="verse" n="Lamentations-1-2" xml:id="f430A-v-Lamentations-1-2" facs="#f430A-zone-Lamentations-1-2"/>
            <w xml:id="f430A-w-258892">בָּכ֨וֹ</w>
          <lb xml:id="f430A-lb-1-6" n="6"/>
            <w xml:id="f430A-w-258893">תִבְכֶּ֜ה</w>
            <w xml:id="f430A-w-258894">בַּלַּ֗יְלָה</w>
            <w xml:id="f430A-w-258895">וְדִמְעָתָהּ֙</w>
          <lb xml:id="f430A-lb-1-7" n="7"/>
            <w xml:id="f430A-w-258896">עַ֣ל</w>
            <w xml:id="f430A-w-258897">לֶֽחֱיָ֔הּ</w>
            <w xml:id="f430A-w-258898">אֵֽין־</w>
            <w xml:id="f430A-w-258899">לָ֥הּ</w>
            <w xml:id="f430A-w-258900">מְנַחֵ֖ם</w>
