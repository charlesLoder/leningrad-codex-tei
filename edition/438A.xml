            <w xml:id="f438A-w-266527">דְּבַר־</w>
            <w xml:id="f438A-w-266528">י֣וֹם</w>
            <w xml:id="f438A-w-266529">בְּיוֹמ֗וֹ</w>
            <w xml:id="f438A-w-266530">מִפַּת־</w>
            <w xml:id="f438A-w-266531">בַּ֤ג</w>
          <lb xml:id="f438A-lb-1-2" n="2"/>
            <w xml:id="f438A-w-266532">הַמֶּ֙לֶךְ֙</w>
            <w xml:id="f438A-w-266533">וּמִיֵּ֣ין</w>
            <w xml:id="f438A-w-266534">מִשְׁתָּ֔יו</w>
          <lb xml:id="f438A-lb-1-3" n="3"/>
            <w xml:id="f438A-w-266535">וּֽלְגַדְּלָ֖ם</w>
            <w xml:id="f438A-w-266536">שָׁנִ֣ים</w>
            <w xml:id="f438A-w-266537">שָׁל֑וֹשׁ</w>
          <lb xml:id="f438A-lb-1-4" n="4"/>
            <w xml:id="f438A-w-266538">וּמִ֨קְצָתָ֔ם</w>
            <w xml:id="f438A-w-266539">יַֽעַמְד֖וּ</w>
