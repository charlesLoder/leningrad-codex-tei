            <w xml:id="f138A-w-91424">בְּחָצ֑וֹר</w>
            <w xml:id="f138A-w-91425">וְשַׂר־</w>
            <w xml:id="f138A-w-91426">צְבָאוֹ֙</w>
            <w xml:id="f138A-w-91427">סִֽיסְרָ֔א</w>
          <lb xml:id="f138A-lb-1-2" n="2"/>
            <w xml:id="f138A-w-91428">וְה֥וּא</w>
            <w xml:id="f138A-w-91429">יוֹשֵׁ֖ב</w>
            <w xml:id="f138A-w-91430">בַּחֲרֹ֥שֶׁת</w>
            <w xml:id="f138A-w-91431">הַגּוֹיִֽם</w>
            <pc type="sof-pasuq" xml:id="f138A-pc-91431">׃</pc>
          <lb xml:id="f138A-lb-1-3" n="3"/>
            <milestone unit="verse" n="Judges-4-3" xml:id="f138A-v-Judges-4-3" facs="#f138A-zone-Judges-4-3"/>
            <w xml:id="f138A-w-91432">וַיִּצְעֲק֥וּ</w>
            <w xml:id="f138A-w-91433">בְנֵֽי־</w>
            <w xml:id="f138A-w-91434">יִשְׂרָאֵ֖ל</w>
            <w xml:id="f138A-w-91435">אֶל־</w>
          <lb xml:id="f138A-lb-1-4" n="4"/>
            <w xml:id="f138A-w-91436">יְהוָ֑ה</w>
            <w xml:id="f138A-w-91437">כִּ֠י</w>
