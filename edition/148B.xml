          <lb xml:id="f148B-lb-1-2" n="2"/>
            <w xml:id="f148B-w-98612">לַחֲמוֹרִ֑ים</w>
            <w xml:id="f148B-w-98613">וַֽיִּרְחֲצוּ֙</w>
            <w xml:id="f148B-w-98614">רַגְלֵיהֶ֔ם</w>
          <lb xml:id="f148B-lb-1-3" n="3"/>
            <w xml:id="f148B-w-98615">וַיֹּאכְל֖וּ</w>
