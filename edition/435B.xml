            <w xml:id="f435B-w-265114">נַעֲרֵ֤י</w>
            <w xml:id="f435B-w-265115">הַמֶּ֙לֶךְ֙</w>
          <lb xml:id="f435B-lb-1-7" n="7"/>
            <w xml:id="f435B-w-265116">מְשָׁ֣רְתָ֔יו</w>
