<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="en">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Schema for Leningrad Codex (Iteration 1)</title>
        <author>Your Name</author>
      </titleStmt>
      <publicationStmt>
        <p>Private draft</p>
      </publicationStmt>
      <sourceDesc>
        <p>Born digital</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <schemaSpec ident="leningradSchema" start="TEI" prefix="tei_">
        
        <!-- Module 1: Required baseline infrastructure -->
        <moduleRef key="tei"/>

        <!-- Module 2: The Metadata Header (titleStmt respStmt credits the
             human contributor resolved from git user.name/user.email plus
             static source credits for the UXLC base text (Kimball) and the
             folio index (Denckla); the UXLC source credit carries the
             edition version/build/date parsed from the UXLC editionStmt;
             persName/@ref carries a mailto: address; revisionDesc/change
             records the contributor via @who plus the contributor date) -->
        <moduleRef key="header" include="teiHeader fileDesc titleStmt title respStmt resp publicationStmt authority availability licence sourceDesc encodingDesc appInfo application revisionDesc change"/>
        <moduleRef key="msdescription" include="msDesc msIdentifier settlement repository idno"/>
        <moduleRef key="namesdates" include="persName"/>
        <moduleRef key="iso-fs" include="fs f string"/>

        <!-- Module 3: Basic Text Structure -->
        <moduleRef key="textstructure" include="TEI text body div"/>

        <!-- Module 4: Core Elements (Milestones & Prose) -->
        <moduleRef key="core" include="p title pb cb lb milestone ptr name label graphic desc del gap"/>

        <!-- Module 4a: Facsimile (one surface per folio side; scripts/zones.py adds
             the Archive.org graphic and one zone per verse, holding one child
             zone per line segment, in Archive.org image pixels) -->
        <moduleRef key="transcr" include="facsimile surface zone"/>

        <!-- Module 5: Words and punctuation (generate-tei splits trailing
             sof-pasuq / paseq off each UXLC atom into pc; w keeps the atom) -->
        <moduleRef key="analysis" include="w pc"/>
        <!-- linking also gives att.global.linking (@next/@prev on del) -->
        <moduleRef key="linking" include="ab"/>

        <!-- Erasures (hand edits, not a pipeline stage): one del per line,
             so lb stays a child of ab. An erasure over more than one line
             joins its parts with @next/@prev. Readable erased words are
             w (no xml:id: they have no UXLC atom), with the consonants
             and only the marks that can be seen (e.g. rafe); a
             visible sof pasuq is pc. Text that cannot be read is
             gap reason="illegible". A w in a del is not part of the
             biblical text: consumers must skip it. -->
        <elementSpec ident="del" mode="change">
          <constraintSpec ident="del-content" scheme="schematron" mode="add">
            <constraint>
              <sch:rule xmlns:sch="http://purl.oclc.org/dsdl/schematron" context="tei:del">
                <sch:assert test="not(.//tei:lb or .//tei:cb or .//tei:milestone)">A del must not contain lb, cb or milestone.</sch:assert>
                <sch:assert test="not(.//tei:w[@xml:id] or .//tei:pc[@xml:id])">A w or pc in a del must not have an xml:id (it has no UXLC atom).</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList>
            <attDef ident="rend" mode="change" usage="req">
              <valList type="closed">
                <valItem ident="erasure"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Custom constraint: 'unit' is required on milestones; 'n' is required
             on verse milestones only (section milestones are identified by xml:id) -->
        <elementSpec ident="milestone" mode="change">
          <constraintSpec ident="milestone-verse-n" scheme="schematron" mode="add">
            <constraint>
              <sch:rule xmlns:sch="http://purl.oclc.org/dsdl/schematron" context="tei:milestone[@unit='verse']">
                <sch:assert test="@n">A verse milestone must have an @n.</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList>
            <attDef ident="unit" mode="change" usage="req"/>
          </attList>
        </elementSpec>

        <elementSpec ident="pc" mode="change">
          <attList>
            <attDef ident="type" mode="change" usage="req">
              <valList type="closed">
                <valItem ident="sof-pasuq"/>
                <valItem ident="paseq"/>
                <valItem ident="inverted-nun"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>

        <!-- Custom constraint: Require 'n' on lines and columns -->
        <elementSpec ident="lb" mode="change">
          <attList>
            <attDef ident="n" mode="change" usage="req"/>
          </attList>
        </elementSpec>
        <elementSpec ident="cb" mode="change">
          <attList>
            <attDef ident="n" mode="change" usage="req"/>
          </attList>
        </elementSpec>

      </schemaSpec>
    </body>
  </text>
</TEI>