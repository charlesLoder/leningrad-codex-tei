---
import { readFileSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import FacsimileViewer from '../../components/FacsimileViewer.astro';
import FeedbackForm from '../../components/FeedbackForm.astro';
import FolioColumns from '../../components/FolioColumns.astro';
import FolioHead from '../../components/FolioHead.astro';
import FolioToolbar from '../../components/FolioToolbar.astro';
import Pager from '../../components/Pager.astro';
import Toggle from '../../components/Toggle.astro';
import { parseFolioXml, folioSideLabel, abbreviateRange } from '../../lib/tei';
import folios from '../../data/folios.json';
import meta from '../../data/meta.json';

export function getStaticPaths() {
  return folios.map((f) => ({ params: { folio: f.folio } }));
}

const { folio } = Astro.params;
const here = dirname(fileURLToPath(import.meta.url));
const xmlPath = join(here, '../../../../edition', `${folio}.xml`);
const xml = readFileSync(xmlPath, 'utf8');
const doc = parseFolioXml(xml);
const entry = folios.find((f) => f.folio === folio);

const idx = folios.findIndex((f) => f.folio === folio);
const prev = idx > 0 ? folios[idx - 1] : null;
const next = idx >= 0 && idx < folios.length - 1 ? folios[idx + 1] : null;

const folioTitle = `Folio ${folioSideLabel(folio ?? '')} · Leningrad Codex TEI`;
const folioDescription = entry
  ? `Folio ${folioSideLabel(folio ?? '')} of the Leningrad Codex (${abbreviateRange(entry.range)}), with transcription and facsimile image.`
  : doc.title;
const folioSchema = {
  '@type': 'Manuscript',
  name: folioTitle,
  description: folioDescription,
  inLanguage: ['en', 'he'],
  isPartOf: { '@type': 'Collection', name: 'Leningrad Codex TEI' },
};
---

<Base title={folioTitle} description={folioDescription} type="article" jsonLd={folioSchema}>
  <FolioHead title={`Folio ${folioSideLabel(folio ?? '')}`} range={entry ? abbreviateRange(entry.range) : doc.title}>
    <Pager prev={prev} next={next} />
    <FolioToolbar>
      {doc.graphicUrl && <Button variant="primary" target="_blank" rel="noopener noreferrer" href={doc.graphicUrl}>Facsimile image <svg class="external-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg></Button>}
      <Button href={`/edition/${folio}.xml`} target="_blank">Raw TEI XML</Button>
      <Toggle />
      <FeedbackForm folio={folio ?? ''} version={meta.version} />
    </FolioToolbar>
  </FolioHead>

  <FolioColumns columns={doc.columns} />

  {doc.graphicUrl && (
    <FacsimileViewer url={doc.graphicUrl} folio={folio ?? ''} />
  )}

  <script>
    const toggle = document.querySelector('#toggle-verses') as HTMLInputElement | null;
    const apply = (on: boolean) => {
      document.querySelectorAll('.verse-tag').forEach((el) => {
        (el as HTMLElement).style.display = on ? '' : 'none';
      });
    };
    toggle?.addEventListener('change', (e) => apply((e.target as HTMLInputElement).checked));
    apply(toggle?.checked ?? false);

    const columns = document.querySelector('.columns');
    const highlight = (ref: string | null, on: boolean) => {
      if (!ref) return;
      columns?.querySelectorAll(`span[data-verse="${ref}"]`).forEach((el) => {
        el.classList.toggle('hl', on);
      });
    };
    columns?.addEventListener('mouseover', (e) => {
      const tag = (e.target as HTMLElement).closest('.verse-tag') as HTMLElement | null;
      highlight(tag?.dataset.verse ?? null, true);
    });
    columns?.addEventListener('mouseout', (e) => {
      const tag = (e.target as HTMLElement).closest('.verse-tag') as HTMLElement | null;
      highlight(tag?.dataset.verse ?? null, false);
    });
  </script>
</Base>
