---
import { existsSync, readFileSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import Base from '../../layouts/Base.astro';
import FeedbackForm from '../../components/FeedbackForm.astro';
import FolioCredits from '../../components/FolioCredits.astro';
import FolioColumns from '../../components/FolioColumns.astro';
import FolioHead from '../../components/FolioHead.astro';
import FolioMenu from '../../components/FolioMenu.astro';
import IiifViewer from '../../components/IiifViewer.astro';
import Pager from '../../components/Pager.astro';
import VerseCard from '../../components/VerseCard.astro';
import { buildViewData } from '../../lib/folio-view';
import { icons } from '../../lib/icons';
import { parseFolioXml, folioSideLabel, abbreviateRange } from '../../lib/tei';
import folios from '../../data/folios.json';
import meta from '../../data/meta.json';

export function getStaticPaths() {
  return folios.map((f) => ({ params: { folio: f.folio } }));
}

const { folio } = Astro.params;
const here = dirname(fileURLToPath(import.meta.url));
const xmlPath = join(here, '../../../../edition', `${folio}.xml`);
const xml = readFileSync(xmlPath, 'utf8');
const doc = parseFolioXml(xml);
const entry = folios.find((f) => f.folio === folio);
// A IIIF manifest exists only for folios with verse zones (see build-iiif).
const iiifPath = join(here, '../../../public/iiif', `${folio}.json`);
const iiifManifest = existsSync(iiifPath) ? `/iiif/${folio}.json` : null;

const idx = folios.findIndex((f) => f.folio === folio);
const prevEntry = idx > 0 ? folios[idx - 1] : null;
const nextEntry = idx >= 0 && idx < folios.length - 1 ? folios[idx + 1] : null;
const neighbor = (f: { folio: string; range: string } | null) => (f ? { folio: f.folio, range: f.range } : null);
const shortNeighbor = (f: { folio: string; range: string } | null) =>
  f ? { folio: f.folio, range: abbreviateRange(f.range) } : null;

const folioTitle = `Folio ${folioSideLabel(folio ?? '')} · Leningrad Codex TEI`;
const folioRef = entry ? abbreviateRange(entry.range) : doc.title;
const folioIdLine = `Leningrad Codex TEI · ${meta.version} · folio ${folioSideLabel(folio ?? '')} · ${folioRef}`;
const folioDescription = entry
  ? `Folio ${folioSideLabel(folio ?? '')} of the Leningrad Codex (${abbreviateRange(entry.range)}), with transcription and facsimile image.`
  : doc.title;
const folioSchema = {
  '@type': 'Manuscript',
  name: folioTitle,
  description: folioDescription,
  inLanguage: ['en', 'he'],
  isPartOf: { '@type': 'Collection', name: 'Leningrad Codex TEI' },
};
const side = folio?.endsWith('A') ? 'Recto' : 'Verso';
const viewData = buildViewData(doc, {
  folio: folio ?? '',
  version: meta.version,
  manifest: iiifManifest,
  prev: neighbor(prevEntry),
  next: neighbor(nextEntry),
});
---

<Base title={folioTitle} description={folioDescription} type="article" jsonLd={folioSchema} desk>
  <Fragment slot="head">
    {iiifManifest && <link rel="preload" as="fetch" href={iiifManifest} crossorigin="anonymous" />}
    {iiifManifest && <link rel="preconnect" href="https://iiif.archive.org" crossorigin="anonymous" />}
  </Fragment>

  <FolioHead slot="header-center" title={`Folio ${folio}`} range={folioRef} detail={`${side} · side ${idx + 1} of ${folios.length}`} />
  <Fragment slot="header-actions">
    <button class="quiet image-toggle" id="toggle-image" type="button" aria-label="Page image" aria-pressed="true" title="Hide page image">
      <Fragment set:html={icons.image} />
      <Fragment set:html={icons.imageOff} />
    </button>
    <FolioMenu folio={folio ?? ''} manifest={iiifManifest} />
  </Fragment>

  <Pager
    prev={shortNeighbor(prevEntry)}
    next={shortNeighbor(nextEntry)}
    hint={iiifManifest ? 'Hover over text to find it on the page. Click to keep it selected. Double-click to zoom the image.' : 'Click a word to select its verse.'}
    touchHint={iiifManifest ? 'Tap a word to see it on the page.' : 'Tap a word to select its verse.'}
  />

  <div class="desk" id="desk" data-view="both">
    <section class="leaf" aria-label="Transcription">
      <p class="print-only">{folioIdLine}</p>
      <FolioColumns columns={doc.columns} firstVerse={doc.verses[0] ?? null} />
    </section>
    <IiifViewer manifestUrl={iiifManifest} imageUrl={doc.graphicUrl} folio={folio ?? ''} />
  </div>
  <VerseCard />

  <FolioCredits credits={doc.credits} model={doc.model} />
  <FeedbackForm folio={folio ?? ''} version={meta.version} />

  <script type="application/json" id="folio-data" set:html={JSON.stringify(viewData).replace(/</g, '\\u003c')} />
  <script>
    import '../../lib/folio-desk.client.ts';
  </script>
</Base>

<style>
  /* The icon shows the state: an image while it is open, a crossed-out image while it is closed. */
  .image-toggle {
    min-width: 2.4rem;
  }

  .image-toggle :global(.lucide) {
    width: 1.35em;
    height: 1.35em;
  }

  .image-toggle[aria-pressed='true'] {
    background: var(--accent-soft);
  }

  .image-toggle[aria-pressed='true'] :global(.lucide-image-off),
  .image-toggle[aria-pressed='false'] :global(.lucide-image) {
    display: none;
  }

  .desk {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
    background: var(--parchment);
  }

  .desk[data-view='text'],
  .desk[data-view='image'] {
    grid-template-columns: minmax(0, 1fr);
  }

  .desk[data-view='text'] :global(.plate) {
    display: none;
  }

  .desk[data-view='image'] .leaf {
    display: none;
  }

  /* Before the page script runs: below this width there is no room for both. */
  @media (max-width: 1199px) {
    .desk[data-view='both'] {
      grid-template-columns: minmax(0, 1fr);
    }

    .desk[data-view='both'] :global(.plate) {
      display: none;
    }
  }

  .leaf {
    min-width: 0;
    padding-inline: max(2.5rem, env(safe-area-inset-right, 0px)) max(2.25rem, env(safe-area-inset-left, 0px));
  }

  /* Image closed: the leaf sits on the page, with room to scroll its last lines out from under the verse card. */
  @media screen and (min-width: 760px) {
    .desk[data-view='text'] {
      background: var(--bg);
    }

    .desk[data-view='text'] .leaf {
      padding-block: 1.5rem 4.5rem;
      padding-inline: 1.25rem;
    }
  }

  @media screen and (max-width: 1399px) {
    .leaf {
      padding-inline: 1.75rem;
    }
  }

  @media screen and (max-width: 759px) {
    .leaf {
      padding-inline: 0;
      padding-block-end: 5rem;
    }
  }

  @media print {
    .desk {
      display: block;
      background: none;
    }

    .desk .leaf {
      display: block;
      padding: 0;
    }
  }
</style>
