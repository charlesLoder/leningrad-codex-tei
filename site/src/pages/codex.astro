---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import FolioHead from '../components/FolioHead.astro';
import { icons } from '../lib/icons';
import { abbreviateRange } from '../lib/tei';
import folios from '../data/folios.json';

const start = folios[0];
const description = 'Read the Leningrad Codex as a book: turn its leaves in 3D, select and copy its text, and hold a lens over the photographed page.';
---

<Base title="Codex · Leningrad Codex TEI" description={description} desk footer={false}>
  <div class="codex" id="codex">
    <div class="codex-head">
      <FolioHead title={`Folio ${start.folio}`} range={abbreviateRange(start.range)} detail="Codex" />
    </div>
    <div class="codex-books" id="codex-books" dir="rtl" role="group" aria-label="Books of the codex, in codex order"></div>

    <div class="codex-small" id="codex-small">
      <h1>The Codex view needs a larger screen</h1>
      <p>The folio page fits this screen, and shows one column at a time.</p>
      <Button id="codex-small-link" href={`/folio/${start.folio}/`} variant="primary">Open folio {start.folio}</Button>
    </div>

    <div class="codex-main">
      <div class="codex-stage" id="codex-stage"></div>

      <noscript>
        <p class="codex-noscript">This view needs JavaScript. <a href="/">Read the folios as pages</a> instead.</p>
      </noscript>

      <p class="codex-hint" id="codex-hint" hidden>
        <span>Drag a page's outer edge to turn it. Select text to copy it. Scroll to come closer, then drag beside the text to look around.</span>
        <button class="codex-chip" id="codex-hint-close" type="button">Got it</button>
      </p>

      <div class="codex-hud" id="codex-hud">
        <!-- These float: if they added height, the camera would refit and move the page under a selection. -->
        <div class="codex-floats">
          <p class="codex-note" id="codex-note" hidden></p>
          <div class="codex-card" id="codex-card" role="status" hidden>
            <span id="codex-card-text"></span>
            <button class="codex-chip" id="codex-card-copy" type="button">Copy verse</button>
            <a class="codex-chip" id="codex-card-link" href="/" hidden>Open folio</a>
          </div>
        </div>

        <div class="codex-bar">
          <div class="codex-tools" role="group" aria-label="What the page shows">
            <button class="quiet codex-tool" type="button" data-mode-choice="text" aria-pressed="true" title="The transcription (T)"><Fragment set:html={icons.type} /><span>Text</span></button>
            <button class="quiet codex-tool" type="button" data-mode-choice="lens" aria-pressed="false" title="A lens over the photograph (L)"><Fragment set:html={icons.scanSearch} /><span>Lens</span></button>
            <button class="quiet codex-tool" type="button" data-mode-choice="photo" aria-pressed="false" title="The photograph (P)"><Fragment set:html={icons.image} /><span>Photo</span></button>
          </div>

          <div class="codex-nav">
            <button class="quiet codex-tool" id="codex-next" type="button" aria-label="Next page" title="Next page (←)"><Fragment set:html={icons.chevronLeft} /></button>
            <div class="codex-scrub">
              <label class="sr-only" for="codex-scrub">Move through the codex</label>
              <input id="codex-scrub" type="range" dir="rtl" min="1" max="462" value="1" />
              <output id="codex-scrub-label" for="codex-scrub"></output>
            </div>
            <button class="quiet codex-tool" id="codex-prev" type="button" aria-label="Previous page" title="Previous page (→)"><Fragment set:html={icons.chevronRight} /></button>
          </div>

          <div class="codex-tools" role="group" aria-label="Camera">
            <button class="quiet codex-tool" id="codex-zoom-out" type="button" aria-label="Move back" title="Move back (-)"><Fragment set:html={icons.minus} /></button>
            <button class="quiet codex-tool" id="codex-zoom-in" type="button" aria-label="Come closer" title="Come closer (+)"><Fragment set:html={icons.plus} /></button>
            <button class="quiet codex-tool" id="codex-reset" type="button" aria-label="Reset the view" title="Reset the view (0)"><Fragment set:html={icons.rotateCcw} /></button>
          </div>
        </div>
      </div>

      <p class="sr-only" id="codex-live" aria-live="polite"></p>
    </div>
  </div>

  <script>
    import { parseRoute, routeToFolioHref } from '../lib/codex/route.ts';

    const small = document.querySelector('#codex-small') as HTMLElement;
    const link = document.querySelector('#codex-small-link') as HTMLAnchorElement;
    const firstSide = link.textContent?.trim().split(' ').pop() ?? '001B';
    let started = false;

    /* The CSS alone decides what is too small. The book loads only when the message is hidden. */
    function update(): void {
      const route = parseRoute(location.hash);
      link.href = routeToFolioHref(route, firstSide);
      link.textContent = `Open folio ${route.side ?? firstSide}`;
      if (!started && getComputedStyle(small).display === 'none') {
        started = true;
        void import('../lib/codex/codex.client.ts');
      }
    }

    update();
    addEventListener('resize', update);
    addEventListener('hashchange', update);
  </script>
</Base>

<style is:global>
  .codex {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
  }

  .codex-head {
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: max(1rem, env(safe-area-inset-left, 0px)) max(1rem, env(safe-area-inset-right, 0px));
    padding-block: 0.25rem;
    border-bottom: 1px solid var(--line);
  }

  .codex-main {
    position: relative;
    grid-row: 3;
    min-height: 0;
  }

  .codex-small {
    display: none;
    grid-row: 3;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .codex-small h1,
  .codex-small p {
    margin: 0;
  }

  .codex-small h1 {
    font-size: 1.25rem;
  }

  .codex-small p {
    max-width: 24rem;
    color: var(--muted);
  }

  /* A phone in either direction. At this size the text of a page is too small to read. */
  @media (max-width: 820px), (max-height: 500px) {
    .codex-small {
      display: flex;
    }

    .codex-books,
    .codex-main,
    .codex-head {
      display: none;
    }
  }

  .codex-stage,
  .codex-canvas,
  .codex-css-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .codex-canvas {
    display: block;
    touch-action: none;
  }

  /* ---------- The page. The same element draws in the canvas and in the plain book. ---------- */

  .codex-page {
    position: absolute;
    top: 0;
    left: 0;
    /* The paper and its ink stay the same in every theme. */
    --ink: var(--page-ink);
    --muted: var(--page-muted);
    --hl: var(--page-hl);
    --hl-pin: var(--page-hl-pin);

    overflow: hidden;
    color: var(--ink);
    color-scheme: light;
    font-family: 'SBL Hebrew', 'Noto Serif Hebrew', 'Ezra SIL', 'Cardo', 'Times New Roman', serif;
    font-variant-ligatures: contextual;
    cursor: default;
    user-select: text;
  }

  /* A sharp copy of the part of a page on screen, drawn when zoomed in (gl-view.ts). */
  .codex-detail {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
  }

  .codex-detail-shift {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Zoomed in, a drag beside the text moves the view. */
  [data-pan='ready'] .codex-page,
  [data-pan='ready'] .codex-col,
  [data-pan='ready'] .codex-line {
    cursor: grab;
  }

  [data-pan='held'],
  [data-pan='held'] * {
    cursor: grabbing !important;
  }

  .codex-page ::selection {
    background: var(--hl-pin);
  }

  .codex-col {
    position: absolute;
    top: 0;
    bottom: 0;
    direction: rtl;
  }

  .codex-line {
    position: absolute;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    line-height: 1;
    white-space: nowrap;
  }

  .codex-he {
    display: inline-block;
    flex: none;
    transform-origin: 100% 50%;
    cursor: text;
  }

  .codex-page .verse-run {
    padding-block: 0.3em;
    border-radius: 0.14em;
    box-decoration-break: clone;
  }

  .codex-page .verse-run.on {
    background: var(--hl);
  }

  .codex-page .verse-run.pin {
    background: var(--hl-pin);
  }

  .codex-page .sof-pasuq,
  .codex-page .paseq,
  .codex-page .inverted-nun,
  .codex-page .section-tag {
    color: var(--muted);
  }

  .codex-page .section-tag {
    padding-inline: 0.35em;
    font-size: 0.72em;
  }

  .codex-foliation {
    position: absolute;
    top: 3.2%;
    color: var(--muted);
    font: italic 14px 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    user-select: none;
  }

  .codex-page[data-face='recto'] .codex-foliation {
    left: 5.5%;
  }

  .codex-page[data-face='verso'] .codex-foliation {
    right: 5.5%;
  }

  /* The photograph shows alone. Its words stay for screen readers, but nothing marks or selects them. */
  [data-mode='photo'] .codex-page {
    user-select: none;
  }

  [data-mode='photo'] .codex-col {
    pointer-events: none;
  }

  [data-mode='photo'] .codex-page .verse-run {
    background: none;
  }

  [data-mode='photo'] .codex-page .codex-he {
    color: transparent;
  }

  [data-mode='photo'] .codex-page .sof-pasuq,
  [data-mode='photo'] .codex-page .paseq,
  [data-mode='photo'] .codex-page .inverted-nun,
  [data-mode='photo'] .codex-page .section-tag,
  [data-mode='photo'] .codex-foliation {
    color: transparent;
  }

  /* ---------- The plain book, for browsers without HTML-in-Canvas. ---------- */

  .codex-css-stage {
    overflow: hidden;
    touch-action: none;
    background: var(--bg);
  }

  .codex-css-book {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  .codex-page-solid {
    backface-visibility: hidden;
    background: var(--page-bg);
    box-shadow: 0 0.6rem 1.8rem var(--leaf-shadow);
  }

  .codex-page-solid[data-face='recto'],
  .codex-blank {
    background-image: linear-gradient(to left, var(--page-shadow), transparent 1.5%);
  }

  .codex-page-solid[data-face='verso'] {
    background-image: linear-gradient(to right, var(--page-shadow), transparent 1.5%);
  }

  .codex-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  [data-mode='photo'] .codex-photo {
    opacity: 1;
  }

  [data-mode='lens'] .codex-photo {
    opacity: 1;
    mask-image: radial-gradient(circle var(--lens-r, 0px) at var(--lens-x, 0) var(--lens-y, 0), #000 96%, transparent);
  }

  /* ---------- The controls. ---------- */

  .codex-hud {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem max(0.75rem, env(safe-area-inset-right, 0px)) max(0.5rem, env(safe-area-inset-bottom, 0px)) max(0.75rem, env(safe-area-inset-left, 0px));
    pointer-events: none;
    font-size: 0.86rem;
  }

  .codex-hud > * {
    pointer-events: auto;
  }

  .codex-hud .codex-floats {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding-inline: 0.75rem;
    pointer-events: none;
  }

  .codex-floats > * {
    pointer-events: auto;
  }

  .codex-bar {
    display: grid;
    grid-template-columns: 1fr minmax(0, 28rem) 1fr;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .codex-bar > .codex-tools:first-child {
    justify-self: start;
  }

  .codex-bar > .codex-tools:last-child {
    justify-self: end;
  }

  .codex-tools,
  .codex-nav,
  .codex-card,
  .codex-note,
  .codex-hint {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.2rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    box-shadow: 0 0.2rem 0.8rem var(--shadow);
  }

  .codex-tool {
    min-width: 2.2rem;
  }

  .codex-tool[aria-pressed='true'] {
    background: var(--accent-soft);
  }

  .codex-tool:disabled {
    color: var(--faint);
    background: none;
    cursor: default;
  }

  .codex-chip:focus-visible,
  .codex-books button:focus-visible,
  .codex-scrub input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .codex-nav {
    min-width: 0;
  }

  .codex-scrub {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    padding-inline: 0.3rem;
  }

  .codex-scrub input {
    flex: 1;
    min-width: 0;
    accent-color: var(--accent);
  }

  .codex-scrub output {
    flex: none;
    min-width: 3.4rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .codex-books {
    grid-row: 2;
    display: flex;
    gap: 1px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .codex-books button {
    flex-basis: 0;
    min-width: 0;
    height: 1.5rem;
    padding: 0 0.15rem;
    overflow: hidden;
    /* The strip runs right to left, but a name such as `1 Sam` reads left to right. */
    direction: ltr;
    color: var(--muted);
    font: 0.68rem system-ui, sans-serif;
    white-space: nowrap;
    background: var(--line);
    border: 0;
    cursor: pointer;
  }

  .codex-books button[data-section='prophets'] {
    background: var(--card);
  }

  .codex-books button[data-section='writings'] {
    background: var(--accent-soft);
  }

  .codex-books button:hover {
    color: var(--on-accent);
    background: var(--accent-strong);
  }

  .codex-books button[data-current] {
    color: var(--on-accent);
    background: var(--accent);
  }

  /* A book too narrow for its name keeps only its tooltip. */
  .codex-books button.codex-book-narrow {
    color: transparent;
  }

  .codex-card {
    gap: 0.5rem;
    padding: 0.2rem 0.25rem 0.2rem 0.75rem;
  }

  .codex-card[hidden],
  .codex-note[hidden],
  .codex-hint[hidden] {
    display: none;
  }

  .codex-note {
    margin: 0;
    padding: 0.35rem 0.7rem;
    color: var(--muted);
  }

  .codex-chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.1rem 0.65rem;
    color: var(--on-accent);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    background: var(--accent);
    border: 0;
    border-radius: 0.42rem;
    cursor: pointer;
  }

  a.codex-chip {
    font-weight: 400;
    color: var(--accent);
    background: var(--accent-soft);
  }

  a.codex-chip[hidden] {
    display: none;
  }

  .codex-hint {
    position: absolute;
    top: 0.75rem;
    left: 50%;
    z-index: 2;
    gap: 0.75rem;
    width: max-content;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0.3rem 0.35rem 0.3rem 0.8rem;
    transform: translateX(-50%);
    font-size: 0.86rem;
  }

  .codex-noscript {
    position: absolute;
    inset: 40% 1rem auto;
    margin: 0;
    text-align: center;
  }
</style>
