---
import Base from '../layouts/Base.astro';
import ContributeCta from '../components/ContributeCta.astro';
import FolioCard from '../components/FolioCard.astro';
import FolioGrid from '../components/FolioGrid.astro';
import Hero from '../components/Hero.astro';
import ResultCount from '../components/ResultCount.astro';
import SearchField from '../components/SearchField.astro';
import folios from '../data/folios.json';
import { abbreviateRange } from '../lib/tei';
import { folioRangeKeys } from '../lib/verses';

const cards = folios.map((f) => {
  const { start, end } = folioRangeKeys(f.range);
  return { ...f, start, end };
});
---
<Base
  title="Leningrad Codex TEI — the oldest complete Hebrew Bible, folio by folio"
  description="Read the Leningrad Codex online: an open, TEI-encoded edition of the oldest complete manuscript of the Hebrew Bible, browsable folio by folio with facsimile images."
>
  <Hero>
    <h1>Leningrad Codex TEI</h1>
    <ContributeCta published={cards.length} />
  </Hero>

  <div>
    <p>
      Read the Leningrad Codex online.
    </p>
    <SearchField />
  </div>

  <ResultCount />
  <FolioGrid>
    {cards.map((f) => (
      <FolioCard
        folio={f.folio}
        range={abbreviateRange(f.range)}
        search={`${f.folio} ${f.title} ${f.range}`.toLowerCase()}
        start={f.start}
        end={f.end}
      />
    ))}
  </FolioGrid>

  <script>
    import { parseVerseQuery } from '../lib/verses';
    const q = document.querySelector('#q') as HTMLInputElement | null;
    const grid = document.querySelector('#grid');
    const count = document.querySelector('#count');
    const rows = [...(grid?.querySelectorAll('li') ?? [])].map((li) => ({
      el: li as HTMLElement,
      search: (li as HTMLElement).dataset.search ?? '',
      start: (li as HTMLElement).dataset.start ? Number((li as HTMLElement).dataset.start) : null,
      end: (li as HTMLElement).dataset.end ? Number((li as HTMLElement).dataset.end) : null,
    }));
    const apply = () => {
      const raw = (q?.value ?? '').trim();
      const needle = raw.toLowerCase();
      const span = parseVerseQuery(raw);
      let visible = 0;
      for (const row of rows) {
        let show: boolean;
        if (!raw) show = true;
        else if (span && row.start !== null && row.end !== null) show = span.start <= row.end && row.start <= span.end;
        else if (span) show = false;
        else show = row.search.includes(needle);
        row.el.style.display = show ? '' : 'none';
        if (show) visible += 1;
      }
      if (count) count.textContent = !raw ? `${rows.length} folios` : visible === 0 ? `No published folio matches “${raw}”.` : `${visible} of ${rows.length} folios`;
    };
    q?.addEventListener('input', apply);
    apply();
  </script>
</Base>
