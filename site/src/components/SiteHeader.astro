---
import meta from '../data/meta.json';
import Button from './Button.astro';
import { icons } from '../lib/icons';
import ThemeToggle from './ThemeToggle.astro';

const github = '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>';
---

<header class="site-header">
  <div class="header-inner wrap">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">ל</span>
      <span class="brand-text">
        <strong>Leningrad Codex TEI{meta.version && <span class="brand-version">{` (${meta.version})`}</span>}</strong>
      </span>
    </a>
    <nav class="nav" aria-label="Site">
      <Button href="/codex/" variant="ghost" style="--button-gap: 0.15rem">Codex <Fragment set:html={icons.flaskConical} /></Button>
      <Button href="/about/" variant="ghost">About</Button>
      <ThemeToggle />
      <Button href="https://github.com/charlesLoder/leningrad-codex-tei" variant="ghost" aria-label="GitHub repository">
        <Fragment set:html={github} />
      </Button>
    </nav>
    <div class="nav-mobile">
      <ThemeToggle />
      <Button variant="ghost" class="menu-button" popovertarget="site-menu" aria-label="Menu" title="Menu">
        <Fragment set:html={icons.menu} />
      </Button>
      <div class="site-menu" id="site-menu" popover>
        <Button variant="ghost" class="menu-link" href="/about/">About</Button>
        <Button variant="ghost" class="menu-link" href="/codex/">Codex <Fragment set:html={icons.flaskConical} /></Button>
        <Button variant="ghost" class="menu-link" href="https://github.com/charlesLoder/leningrad-codex-tei">GitHub <Fragment set:html={github} /></Button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--card);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.6rem;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 1.4rem;
  }

  .brand-text {
    display: grid;
  }

  .brand-text :global(small) {
    color: var(--muted);
  }

  .nav {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .nav-mobile {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  /* Author display beats the UA's hide rule for closed popovers, so hide it explicitly. */
  .site-menu:not(:popover-open) {
    display: none;
  }

  /* The popover's invoker is an implicit anchor, so position-area can tether it. Auto margin/inset resolve to 0 with position-area set. */
  .site-menu {
    margin: 0;
    position-area: bottom span-left;
    justify-self: end;
    margin-block-start: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 12rem;
    padding: 0.3rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    box-shadow: 0 0.6rem 1.8rem var(--shadow);
  }

  .site-menu :global(.menu-link) {
    justify-content: start;
    min-height: 2.6rem;
  }

  @media (max-width: 759px) {
    .header-inner {
      gap: 0.5rem;
    }

    .brand-version {
      display: none;
    }

    .nav {
      display: none;
    }

    .nav-mobile {
      display: flex;
    }
  }
</style>
