---
import { icons } from '../lib/icons';
import Button from './Button.astro';

interface Props {
  title: string;
  range: string;
  /** e.g. `Recto · side 40 of 920` */
  detail: string;
}

const { title, range, detail } = Astro.props;
---

<div class="folio-jump">
  <Button variant="ghost" class="folio-title" popovertarget="folio-jump-body" aria-label={`${title}. Go to a folio or verse`}>
    <span class="folio-title-text">
      <h1>{title}</h1>
      <span class="folio-range">{range}</span>
    </span>
    <Fragment set:html={icons.search} />
  </Button>
  <div class="jump-body" id="folio-jump-body" popover>
    <label>
      <span class="sr-only">Go to a folio or verse</span>
      <input id="goto-input" type="search" autocomplete="off" placeholder="Go to Exod 3:14 or 250A" />
    </label>
    <ul id="goto-list" hidden></ul>
    <p>{detail}</p>
  </div>
</div>

<style>
  .folio-title[data-variant='ghost'] {
    gap: 0.5rem;
    line-height: 1.2;
    padding-inline: 0.9rem;
  }

  .folio-title-text {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-align: center;
  }

  .folio-title h1 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .folio-title .folio-range {
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  /* Author display beats the UA's hide rule for closed popovers, so hide it explicitly. */
  .jump-body:not(:popover-open) {
    display: none;
  }

  /* The popover's invoker is an implicit anchor, so position-area can tether it. Auto margin/inset resolve to 0 with position-area set. */
  .jump-body {
    margin: 0;
    position-area: bottom;
    justify-self: anchor-center;
    margin-block-start: 0.35rem;
    max-block-size: 70vh;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: min(21rem, calc(100vw - 2rem));
    padding: 0.55rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    box-shadow: 0 0.6rem 1.8rem var(--shadow);
  }

  .jump-body input {
    width: 100%;
    min-height: 2.3rem;
    padding: 0.25rem 0.6rem;
    font: inherit;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 0.45rem;
  }

  .jump-body input::placeholder {
    color: var(--muted);
  }

  .jump-body p {
    margin: 0;
    padding: 0.1rem 0.2rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  #goto-list {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #goto-list[hidden] {
    display: none;
  }

  #goto-list :global(a) {
    display: flex;
    flex-direction: column;
    padding: 0.35rem 0.55rem;
    border-radius: 0.35rem;
    color: var(--ink);
    font-size: 0.9rem;
    text-decoration: none;
  }

  #goto-list :global(a:hover),
  #goto-list :global(a.first) {
    background: var(--accent-soft);
  }

  #goto-list :global(small),
  #goto-list :global(.goto-none) {
    color: var(--muted);
    font-size: 0.76rem;
  }

  #goto-list :global(.goto-none) {
    padding: 0.35rem 0.55rem;
  }
</style>
