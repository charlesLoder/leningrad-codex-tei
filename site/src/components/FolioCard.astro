---
import Button from './Button.astro';

interface Props {
  folio: string;
  range: string;
}

const { folio, range } = Astro.props;
---

<li>
  <Button class="folio-card" href={`/folio/${folio}/`} variant="secondary">
    <h2>{folio}</h2>
    <span class="range">{range}</span>
  </Button>
</li>

<style>
  li {
    display: contents;
  }

  .folio-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.25rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    border-radius: 0.9rem;
    text-align: left;
  }

  .folio-card h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .folio-card .range {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
