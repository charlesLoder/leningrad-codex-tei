---
import type { TeiLine as TeiLineType } from '../lib/tei';

interface Props {
  col: string | number;
  line: TeiLineType;
  showLineNumber?: boolean;
}

const { col, line, showLineNumber = false } = Astro.props;

const verseMarks = [
  ...new Map(
    line.tokens
      .flatMap((t) => t.marks)
      .filter((mk) => mk.kind === 'verse')
      .map((mk) => [mk.ref, mk]),
  ).values(),
];
---

<div class:list={['tei-line', { numbered: showLineNumber }]} data-col={col} data-line={line.n}>
  {showLineNumber && <span class="ln">{line.n}</span>}
  <div class="gutter">
    {verseMarks.map((mk) => (
      <span class="verse-tag" data-verse={mk.ref} title="Highlight verse">{mk.ref}</span>
    ))}
  </div>
  <p class="he">
    {line.tokens.map((t, i) => (
      <>
        {t.kind === "sof-pasuq" && i > 0 ? '\u00A0' : ""}
        <span class={`${t.kind === 'w' ? '' : t.kind}${t.text.endsWith("־") ? ' maqaf' : ''}`.trim()} data-verse={t.verse}>
          {t.text}
        </span>
        {t.marks.filter((mk) => mk.kind === 'section').map((mk) => (
          <span class="section-tag" data-verse={t.verse} title="Paragraph division">
            {mk.subtype === 'samekh' ? 'ס' : mk.subtype === 'pe' ? 'פ' : mk.subtype}
          </span>
        ))}{line.tokens[i + 1]?.kind === "sof-pasuq" ? "" : ' '}
      </>
    ))}
    {line.marks.map((mk) => (
      <span class="section-tag" title="Paragraph division">
        {mk.subtype === 'samekh' ? 'ס' : mk.subtype === 'pe' ? 'פ' : mk.subtype}
      </span>
    ))}
  </p>
</div>

<style>
  .tei-line {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.6rem;
    padding: 0;
    border-bottom: 1px solid var(--parchment-rule);
  }

  /* First column only: line numbers get their own narrow track. */
  .tei-line.numbered {
    grid-template-columns: 1.6rem 3.4rem 1fr;
  }

  .ln {
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 2.4;
    text-align: center;
  }

  .gutter {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .he {
    direction: rtl;
    /* Fluid with the container (.columns-frame); never below 1rem. */
    font-size: clamp(1rem, 5cqi, 1.4rem);
    line-height: 1.7;
    margin: 0;
    font-family: 'SBL Hebrew', 'Noto Serif Hebrew', 'Ezra SIL', 'Cardo', 'Times New Roman', serif;
    /* Alternate glyphs: keep contextual alternates on so the font
       uses its alternate ayin when ayin carries a vowel. Named
       alternates (font-variant-alternates + @font-feature-values)
       need a named ayin variant in the font; these fonts expose
       the voweled ayin only as a contextual alternate. */
    font-variant-ligatures: contextual;
  }

  /* Wide enough for several columns side by side. */
  @container (min-width: 60rem) {
    .he {
      font-size: clamp(1rem, 2.1cqi, 1.4rem);
    }
  }

  /* Blank manuscript lines (e.g. open petucha lines) carry no words.
     Hold their full line height so the line stays visible. */
  .he:empty::before {
    content: '\00A0';
  }

  .verse-tag {
    direction: ltr;
    font-size: 0.68rem;
    line-height: 1.3;
    text-align: right;
    color: var(--muted);
    font-family: system-ui, sans-serif;
    cursor: pointer;
  }

  .verse-tag:hover {
    color: var(--accent);
  }

  .he :global(span.hl) {
    background: #eed9a8;
    box-shadow: 0.18em 0 0 #eed9a8, -0.18em 0 0 #eed9a8;
  }

  .he :global(span.hl.maqaf) {
    box-shadow: 0.18em 0 0 #eed9a8, 0 0 0 #eed9a8;
  }

  .he :global(span.hl.sof-pasuq) {
    box-shadow: 0 0 0 #eed9a8, -0.18em 0 0 #eed9a8;
  }

  .section-tag {
    display: inline-block;
    direction: ltr;
    font-size: 0.68rem;
    vertical-align: middle;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    padding: 0 0.3rem;
    margin-inline-end: 0.35rem;
    color: var(--muted);
    font-family: system-ui, sans-serif;
  }

  .he :global(.sof-pasuq) {
    color: var(--accent);
    margin-inline-start: -0.18em;
  }

  .he :global(.paseq),
  .he :global(.inverted-nun) {
    color: var(--muted);
  }

  .he :global(.maqaf) {
    margin-inline-end: -0.35rem;
  }

  /* Feedback pick mode is toggled on <body>; keep selectors global */
  :global(body.picking) .tei-line {
    cursor: pointer;
    border-radius: 0.4rem;
  }

  :global(body.picking) .tei-line:hover {
    background: var(--accent-soft);
  }

  :global(body.picking) .tei-line:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.tei-line.picked) {
    background: var(--accent-soft);
    outline: 1px solid var(--accent);
    outline-offset: -1px;
    border-radius: 0.4rem;
  }

  @media print {
    .tei-line,
    .tei-line.numbered {
      break-inside: avoid;
      border-bottom: 0;
      padding: 0.12rem 0;
      grid-template-columns: 1fr;
    }

    .gutter,
    .ln {
      display: none;
    }

    /* Verse markers print only when the toggle is on. */
    :global(.columns.show-verses) .tei-line {
      grid-template-columns: 1.9rem 1fr;
      gap: 0.25rem;
    }

    :global(.columns.show-verses) .gutter {
      display: flex;
    }

    .verse-tag {
      font-size: 0.42rem;
      line-height: 1.2;
      color: #000;
    }

    .he {
      font-size: 1.75vh;
      line-height: 1.7;
      color: #000;
    }

    .he :global(span.hl) {
      background: none;
      box-shadow: none;
    }

    .section-tag {
      display: none;
    }

    .he :global(.sof-pasuq),
    .he :global(.paseq),
    .he :global(.inverted-nun) {
      color: #000;
    }
  }
</style>
