---
import { lineHtml } from '../lib/folio-view';
import type { TeiLine as TeiLineType } from '../lib/tei';

interface Props {
  col: string | number;
  line: TeiLineType;
  firstVerse: string | null;
}

const { col, line, firstVerse } = Astro.props;
const five = Number(line.n) % 5 === 0;
---

<div class:list={['tei-line', { five }]} data-col={col} data-line={line.n}>
  <span class="ln">{line.n}</span>
  <p class="he" lang="he"><span class="he-inner" set:html={lineHtml(line, firstVerse) || '&nbsp;'} /></p>
</div>

<style>
  .tei-line {
    position: relative;
    display: flex;
    align-items: center;
    height: var(--row, 2em);
    scroll-margin: calc(var(--head) + var(--strip) + 1rem) 0 1rem;
  }

  :global(.desk[data-view='text']) .tei-line {
    scroll-margin-bottom: 7rem;
  }

  /* Every fifth line is numbered; the others show on hover or when linked. */
  .ln {
    position: absolute;
    inset-inline-start: -1.7rem;
    width: 1.3rem;
    text-align: center;
    color: var(--faint);
    font: 0.66rem system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 0.12s;
  }

  :global(.column.first) .five .ln,
  :global(.column.first) .tei-line:hover .ln,
  :global(.tei-line.cur) .ln {
    opacity: 1;
  }

  :global(.tei-line.cur) .ln {
    color: var(--accent);
    font-weight: 700;
  }

  .he {
    width: 100%;
    min-width: 0;
    margin: 0;
    direction: rtl;
    line-height: 1;
    white-space: nowrap;
    font-family: 'SBL Hebrew', 'Noto Serif Hebrew', 'Ezra SIL', 'Cardo', 'Times New Roman', serif;
    /* Alternate glyphs: keep contextual alternates on so the font
       uses its alternate ayin when ayin carries a vowel. Named
       alternates (font-variant-alternates + @font-feature-values)
       need a named ayin variant in the font; these fonts expose
       the voweled ayin only as a contextual alternate. */
    font-variant-ligatures: contextual;
  }

  .he-inner {
    display: inline-block;
  }

  .he :global(.verse-run) {
    padding-block: 0.34em;
    border-radius: 0.18em;
    cursor: pointer;
    transition: background-color 0.1s;
  }

  .he :global(.verse-run.on) {
    background: var(--hl);
  }

  .he :global(.verse-run.pin) {
    background: var(--hl-pin);
  }

  .he :global(.sof-pasuq),
  .he :global(.paseq),
  .he :global(.inverted-nun) {
    color: var(--muted);
  }

  .he :global(.section-tag) {
    padding-inline: 0.4em;
    font-size: 0.72em;
    color: var(--muted);
  }

  .he :global(.verse-num) {
    display: none;
    padding-inline: 0.1em 0.3em;
    direction: ltr;
    unicode-bidi: isolate;
    font: 500 0.48em system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    vertical-align: 0.6em;
  }

  :global(.columns.show-verses) .he :global(.verse-num) {
    display: inline;
  }

  @media screen and (max-width: 759px) {
    .ln {
      inset-inline-start: -1.45rem;
    }

    .five .ln {
      opacity: 1;
    }
  }

  /* Image closed: ruled lines, every line numbered, and marked punctuation. */
  @media screen and (min-width: 760px) {
    :global(.desk[data-view='text']) .tei-line {
      height: auto;
      padding-inline-start: 4rem;
      border-top: 1px solid var(--leaf-rule);
    }

    :global(.desk[data-view='text'] .column.first) .tei-line {
      padding-inline-start: 6.2rem;
    }

    :global(.desk[data-view='text']) .ln {
      inset-inline-start: 0;
      width: 1.6rem;
      color: var(--muted);
      font-size: 0.75rem;
    }

    :global(.desk[data-view='text'] .column.first) .ln {
      opacity: 1;
    }

    :global(.desk[data-view='text']) .he {
      line-height: 1.7;
    }

    :global(.desk[data-view='text']) .he :global(.sof-pasuq) {
      color: var(--accent);
    }

    :global(.desk[data-view='text']) .he :global(.section-tag) {
      display: inline-block;
      margin-inline-end: 0.35rem;
      padding: 0 0.3rem;
      border: 1px solid var(--line);
      border-radius: 0.3rem;
      font: 0.68rem system-ui, sans-serif;
      vertical-align: middle;
    }
  }

  /* Feedback pick mode is toggled on <body>; keep selectors global */
  :global(body.picking) .tei-line {
    cursor: pointer;
    border-radius: 0.4rem;
  }

  :global(body.picking) .tei-line:hover {
    background: var(--accent-soft);
  }

  :global(body.picking) .tei-line:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.tei-line.picked) {
    background: var(--accent-soft);
    outline: 1px solid var(--accent);
    outline-offset: -1px;
    border-radius: 0.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ln,
    .he :global(.verse-run) {
      transition: none;
    }
  }

  @media print {
    .tei-line {
      height: auto;
      padding: 0.12rem 0;
      break-inside: avoid;
    }

    .ln,
    .he :global(.section-tag) {
      display: none;
    }

    .he {
      line-height: 1.7;
      color: #000;
    }

    .he :global(.verse-run.on),
    .he :global(.verse-run.pin) {
      background: none;
    }

    /* Verse numbers print only when the toggle is on. */
    .he :global(.verse-num),
    .he :global(.sof-pasuq),
    .he :global(.paseq),
    .he :global(.inverted-nun) {
      color: #000;
    }
  }
</style>
