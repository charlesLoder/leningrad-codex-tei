---
import type { TeiLine as TeiLineType } from '../lib/tei';

interface Props {
  col: string | number;
  line: TeiLineType;
}

const { col, line } = Astro.props;

const verseMarks = [
  ...new Map(
    line.tokens
      .flatMap((t) => t.marks)
      .filter((mk) => mk.kind === 'verse')
      .map((mk) => [mk.ref, mk]),
  ).values(),
];
---

<div class="tei-line" data-col={col} data-line={line.n}>
  <div class="gutter">
    <span class="ln">{line.n}</span>
    {verseMarks.map((mk) => (
      <span class="verse-tag" data-verse={mk.ref} title="Highlight verse">{mk.ref}</span>
    ))}
  </div>
  <p class="he">
    {line.tokens.map((t, i) => (
      <>
        {t.kind === "sof-pasuq" && i > 0 ? '\u00A0' : ""}
        <span class={`${t.kind === 'w' ? '' : t.kind}${t.text.endsWith("־") ? ' maqaf' : ''}`.trim()} data-verse={t.verse}>
          {t.text}
        </span>
        {t.marks.filter((mk) => mk.kind === 'section').map((mk) => (
          <span class="section-tag" data-verse={t.verse} title="Paragraph division">
            {mk.subtype === 'samekh' ? 'ס' : mk.subtype === 'pe' ? 'פ' : mk.subtype}
          </span>
        ))}{line.tokens[i + 1]?.kind === "sof-pasuq" ? "" : ' '}
      </>
    ))}
  </p>
</div>

<style>
  .tei-line {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.6rem;
    padding: 0.3rem 0;
    border-top: 1px dotted var(--line);
  }

  .tei-line:first-of-type {
    border-top: 0;
  }

  .gutter {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .ln {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .he {
    direction: rtl;
    font-size: 1.3rem;
    line-height: 1.9;
    margin: 0;
    font-family: 'SBL Hebrew', 'Noto Serif Hebrew', 'Ezra SIL', 'Times New Roman', serif;
  }

  .verse-tag {
    direction: ltr;
    font-size: 0.68rem;
    line-height: 1.3;
    text-align: right;
    color: var(--muted);
    font-family: system-ui, sans-serif;
    cursor: pointer;
  }

  .verse-tag:hover {
    color: var(--accent);
  }

  .he :global(span.hl) {
    background: #eed9a8;
    box-shadow: 0.18em 0 0 #eed9a8, -0.18em 0 0 #eed9a8;
  }

  .he :global(span.hl.maqaf) {
    box-shadow: 0.18em 0 0 #eed9a8, 0 0 0 #eed9a8;
  }

  .he :global(span.hl.sof-pasuq) {
    box-shadow: 0 0 0 #eed9a8, -0.18em 0 0 #eed9a8;
  }

  .section-tag {
    display: inline-block;
    direction: ltr;
    font-size: 0.68rem;
    vertical-align: middle;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    padding: 0 0.3rem;
    margin-inline-end: 0.35rem;
    color: var(--muted);
    font-family: system-ui, sans-serif;
  }

  .he :global(.sof-pasuq) {
    color: var(--accent);
    margin-inline-start: -0.18em;
  }

  .he :global(.paseq) {
    color: var(--muted);
  }

  .he :global(.maqaf) {
    margin-inline-end: -0.35rem;
  }

  /* Feedback pick mode is toggled on <body>; keep selectors global */
  :global(body.picking) .tei-line {
    cursor: pointer;
    border-radius: 0.4rem;
  }

  :global(body.picking) .tei-line:hover {
    background: var(--accent-soft);
  }

  :global(body.picking) .tei-line:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.tei-line.picked) {
    background: var(--accent-soft);
    outline: 1px solid var(--accent);
    outline-offset: -1px;
    border-radius: 0.4rem;
  }
</style>
