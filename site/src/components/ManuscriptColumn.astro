---
import type { TeiColumn } from '../lib/tei';
import TeiLine from './TeiLine.astro';

interface Props {
  col: TeiColumn;
  first?: boolean;
  firstVerse: string | null;
}

const { col, first = false, firstVerse } = Astro.props;
---

<section class:list={['column', { first }]} data-column={col.n}>
  <h2 class="sr-only">Column {col.n}</h2>
  {col.lines.map((line) => (
    <TeiLine col={col.n} line={line} firstVerse={firstVerse} />
  ))}
</section>

<style>
  .column {
    min-width: 0;
    direction: rtl;
  }

  @media screen and (max-width: 759px) {
    .column {
      flex: 0 0 100%;
      scroll-snap-align: start;
      padding-inline: calc(max(1rem, env(safe-area-inset-right, 0px)) + 1.1rem) max(1rem, env(safe-area-inset-left, 0px));
    }
  }

  @media print {
    .column {
      padding: 0;
      break-inside: auto;
    }
  }
</style>
