---
import type { TeiColumn } from '../lib/tei';
import TeiLine from './TeiLine.astro';

interface Props {
  col: TeiColumn;
  first?: boolean;
  ruler?: boolean;
  firstVerse: string | null;
}

const { col, first = false, ruler = false, firstVerse } = Astro.props;
---

<section class:list={['column', { first, ruler }]} data-column={col.n}>
  <h2 class="sr-only">Column {col.n}</h2>
  {col.lines.map((line) => (
    <TeiLine col={col.n} line={line} firstVerse={firstVerse} />
  ))}
</section>

<style>
  .column {
    min-width: 0;
    direction: rtl;
  }

  @media screen and (max-width: 759px) {
    .column {
      flex: 0 0 100%;
      scroll-snap-align: start;
      /* The verse gutter is on the right and the line numbers are on the left. */
      padding-inline: calc(env(safe-area-inset-right, 0px) + 3rem) calc(env(safe-area-inset-left, 0px) + 1.6rem);
    }
  }

  @media print {
    .column {
      padding: 0;
      break-inside: auto;
    }
  }
</style>
