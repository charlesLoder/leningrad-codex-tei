---
import TeiLine from './TeiLine.astro';
import type { TeiColumn } from '../lib/tei';

interface Props {
  col: TeiColumn;
  showLineNumbers?: boolean;
}

const { col, showLineNumbers = false } = Astro.props;
---

<section class="column">
  <h2>Column {col.n}</h2>
  {col.lines.map((line) => (
    <TeiLine col={col.n} line={line} showLineNumber={showLineNumbers} />
  ))}
</section>

<style>
  .column {
    direction: rtl;
    min-width: 0;
  }

  /* The page has no column titles; keep the heading for screen readers. */
  .column h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media print {
    .column {
      background: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0;
      break-inside: auto;
    }

    .column h2 {
      display: none;
    }
  }
</style>
