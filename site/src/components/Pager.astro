---
import { icons } from '../lib/icons';
import Button from './Button.astro';

interface Props {
  prev?: { folio: string; range: string } | null;
  next?: { folio: string; range: string } | null;
  /** Directions shown inside the info panel. */
  hint: string;
  touchHint: string;
}

const { prev, next, hint, touchHint } = Astro.props;
---

<div class="pager">
  {next ? (
    <Button variant="ghost" rel="next" href={`/folio/${next.folio}/`} title={`Next: ${next.range}`} aria-label={`Next: ${next.folio} ${next.range}`}><Fragment set:html={icons.arrowLeft} /> <span class="pager-word">Next</span> <span class="code">{next.folio}</span></Button>
  ) : <span />}
  <div class="pager-middle">
    <slot />
    <div class="hint-info">
      <Button variant="ghost" popovertarget="hint-body" aria-label="How to use this page" title="How to use this page"><Fragment set:html={icons.info} /></Button>
      <div class="hint-body" id="hint-body" popover>
        <span class="pointer-hint">{hint}</span><span class="touch-hint">{touchHint}</span>
      </div>
    </div>
  </div>
  {prev ? (
    <Button variant="ghost" rel="prev" href={`/folio/${prev.folio}/`} title={`Previous: ${prev.range}`} aria-label={`Previous: ${prev.folio} ${prev.range}`}><span class="code">{prev.folio}</span> <span class="pager-word">Previous</span> <Fragment set:html={icons.arrowRight} /></Button>
  ) : <span />}
</div>

<style>
  .pager {
    position: sticky;
    top: 0;
    z-index: 24;
    display: grid;
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--strip);
    padding-inline: max(1rem, env(safe-area-inset-left, 0px)) max(1rem, env(safe-area-inset-right, 0px));
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .pager > a:first-child {
    justify-self: start;
  }

  .pager > a:last-child {
    justify-self: end;
  }

  .pager-middle {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .code {
    color: var(--faint);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  /* Author display beats the UA's hide rule for closed popovers, so hide it explicitly. */
  .hint-body:not(:popover-open) {
    display: none;
  }

  /* The popover's invoker is an implicit anchor, so position-area can tether it. Auto margin/inset resolve to 0 with position-area set. */
  .hint-body {
    margin: 0;
    position-area: bottom span-left;
    justify-self: end;
    margin-block-start: 0.35rem;
    max-block-size: 70vh;
    overflow: auto;
    width: min(21rem, calc(100vw - 2rem));
    padding: 0.55rem 0.7rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    box-shadow: 0 0.6rem 1.8rem var(--shadow);
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.25;
  }

  .touch-hint {
    display: none;
  }

  @media (hover: none) {
    .pointer-hint {
      display: none;
    }

    .touch-hint {
      display: inline;
    }
  }

  @media (max-width: 759px) {
    .pager {
      gap: 0.25rem;
      padding-inline: 0.25rem;
    }

    .pager-middle {
      gap: 0;
    }

    .code,
    .pager-word {
      display: none;
    }

    /* The panel spans the screen so it never clips off screen. */
    .hint-body {
      position-area: bottom;
      justify-self: stretch;
      margin-inline: 0.5rem;
      width: auto;
    }
  }
</style>
