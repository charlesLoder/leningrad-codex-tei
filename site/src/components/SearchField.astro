---
interface Props {
  id?: string;
  placeholder?: string;
}

const { id = 'q', placeholder = 'Filter by folio or verse (e.g. 002A, Gen 3:15)…' } = Astro.props;
---

<div class="controls">
  <input id={id} type="search" placeholder={placeholder} autocomplete="off" />
</div>

<style>
  .controls {
    display: flex;
    gap: 0.75rem;
    margin: 1.2rem 0;
  }

  .controls input {
    flex: 1;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    font: inherit;
    background: var(--card);
  }
</style>
